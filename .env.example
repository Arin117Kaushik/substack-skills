# Only needed for substack-publisher. Every other skill works with nothing set.
# Put your real copy at ~/.substack-skills/.env so plugin updates never touch it
# and it never lands in a git repo.

# Your publication, e.g. https://yourname.substack.com or your custom domain
PUBLICATION_URL=

# Your logged-in browser session, as one line. To get it:
#   1. Sign in at substack.com and open DevTools > Network
#   2. Refresh, click any request to substack.com
#   3. Copy the full value of the "cookie" request header
# This is as good as your password. Never paste it into a chat or commit it.
COOKIES_STRING=

# Or a JSON cookie file instead of COOKIES_STRING
# COOKIES_PATH=
