# Only needed for substack-publisher. Every other skill works with nothing set.
# Put your real copy at ~/.substack-skills/.env so plugin updates never touch it
# and it never lands in a git repo.

# Only for posts: your publication, e.g. https://yourname.substack.com or your custom domain.
# Notes work without it. `publish.py check` lists the publications your account has.
PUBLICATION_URL=

# Your logged-in browser session. Easiest way to get it:
#   1. Sign in at substack.com, press F12, open the Application tab
#   2. Storage > Cookies > https://substack.com, find substack.sid
#   3. Copy its value and write the line as: COOKIES_STRING=substack.sid=<value>
# This is as good as your password. Never paste it into a chat or commit it.
COOKIES_STRING=

# Or a JSON cookie file instead of COOKIES_STRING
# COOKIES_PATH=
